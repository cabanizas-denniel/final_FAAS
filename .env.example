# ---- API ----
APP_NAME="Audio Transcription FaaS"
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200

# ---- Whisper ----
# Model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=tiny
# Device: cpu | cuda | auto
WHISPER_DEVICE=cpu
# Compute type: int8 (CPU recommended), int8_float16, float16 (GPU), float32
WHISPER_COMPUTE_TYPE=int8
# Leave empty to auto-detect the spoken language
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=1

# ---- Concurrency ----
MAX_CONCURRENT_JOBS=2
JOB_RETENTION_SECONDS=3600
